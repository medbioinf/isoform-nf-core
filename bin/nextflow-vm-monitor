#!/usr/bin/env python3
"""Monitor live and recent Nextflow runs on a single VM.

The script intentionally uses only the Python standard library. It discovers
active Nextflow driver processes via /proc and recent runs via .nextflow/history
files, so it works across multiple pipeline directories on the same VM.
"""

import argparse
import json
import os
import time
from pathlib import Path


SKIP_DIRS = {
    ".git",
    ".nf-test",
    ".nextflow",
    "__pycache__",
    "results",
    "work",
}


def parse_args():
    parser = argparse.ArgumentParser(
        description="List active and recent Nextflow runs on this VM."
    )
    parser.add_argument(
        "--root",
        action="append",
        default=[],
        help="Root directory to scan. May be provided more than once. Defaults to $HOME.",
    )
    parser.add_argument(
        "--max-depth",
        type=int,
        default=4,
        help="Maximum directory depth to scan below each root.",
    )
    parser.add_argument(
        "--history-limit",
        type=int,
        default=20,
        help="Maximum recent history rows to print.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit machine-readable JSON instead of a table.",
    )
    parser.add_argument(
        "--watch",
        type=int,
        default=0,
        metavar="SECONDS",
        help="Refresh every SECONDS until interrupted.",
    )
    return parser.parse_args()


def iter_launch_dirs(root, max_depth):
    root = Path(root).expanduser().resolve()
    if not root.exists():
        return

    root_parts = len(root.parts)
    for current, dirs, files in os.walk(root):
        current_path = Path(current)
        depth = len(current_path.parts) - root_parts
        if ".nextflow" in dirs:
            history = current_path / ".nextflow" / "history"
            if history.exists():
                yield current_path

        dirs[:] = [
            d for d in dirs
            if d not in SKIP_DIRS and not d.startswith(".cache")
        ]

        if depth >= max_depth:
            dirs[:] = []


def parse_history(path):
    rows = []
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return rows

    for line in lines:
        fields = line.split("\t", 6)
        if len(fields) != 7:
            continue
        timestamp, duration, name, status, revision, session_id, command = fields
        rows.append({
            "timestamp": timestamp,
            "duration": duration,
            "name": name,
            "status": status,
            "revision": revision,
            "session_id": session_id,
            "command": command,
            "launch_dir": str(path.parent.parent),
        })
    return rows


def recent_history(roots, max_depth, limit):
    rows = []
    seen_launch_dirs = set()
    for root in roots:
        for launch_dir in iter_launch_dirs(root, max_depth):
            if launch_dir in seen_launch_dirs:
                continue
            seen_launch_dirs.add(launch_dir)
            rows.extend(parse_history(launch_dir / ".nextflow" / "history"))
    rows.sort(key=lambda row: row["timestamp"], reverse=True)
    return rows[:limit]


def active_nextflow_processes():
    proc = Path("/proc")
    if not proc.exists():
        return []

    active = []
    for pid_dir in proc.iterdir():
        if not pid_dir.name.isdigit():
            continue
        try:
            raw_cmdline = (pid_dir / "cmdline").read_bytes()
            cmdline = raw_cmdline.replace(b"\x00", b" ").decode(errors="replace").strip()
            if "nextflow" not in cmdline or " run " not in f" {cmdline} ":
                continue
            cwd = os.readlink(pid_dir / "cwd")
        except OSError:
            continue

        active.append({
            "pid": int(pid_dir.name),
            "cwd": cwd,
            "command": cmdline,
        })

    active.sort(key=lambda row: row["pid"])
    return active


def collect_state(args):
    roots = args.root or [str(Path.home())]
    return {
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "roots": roots,
        "active": active_nextflow_processes(),
        "recent": recent_history(roots, args.max_depth, args.history_limit),
    }


def shorten(value, width):
    value = str(value)
    if len(value) <= width:
        return value
    return value[: width - 1] + "…"


def print_table(state):
    print(f"Generated: {state['generated_at']}")
    print(f"Roots: {', '.join(state['roots'])}")
    print()

    print("Active Nextflow processes")
    if state["active"]:
        print(f"{'PID':>8}  {'CWD':<45}  COMMAND")
        for row in state["active"]:
            print(
                f"{row['pid']:>8}  "
                f"{shorten(row['cwd'], 45):<45}  "
                f"{shorten(row['command'], 100)}"
            )
    else:
        print("  none")

    print()
    print("Recent Nextflow history")
    if state["recent"]:
        print(f"{'STARTED':<19}  {'STATUS':<8}  {'DURATION':<9}  {'NAME':<24}  LAUNCH DIR")
        for row in state["recent"]:
            print(
                f"{row['timestamp']:<19}  "
                f"{row['status']:<8}  "
                f"{row['duration']:<9}  "
                f"{shorten(row['name'], 24):<24}  "
                f"{shorten(row['launch_dir'], 80)}"
            )
    else:
        print("  no .nextflow/history files found")


def main():
    args = parse_args()
    while True:
        state = collect_state(args)
        if args.json:
            print(json.dumps(state, indent=2, sort_keys=True))
        else:
            print_table(state)

        if not args.watch:
            break
        time.sleep(args.watch)
        if not args.json:
            print("\n" + "-" * 80 + "\n")


if __name__ == "__main__":
    main()
