{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Anton-Bch/isoform-nf-core/main/nextflow_schema.json",
    "title": "Anton-Bch/isoform-nf-core pipeline parameters",
    "description": "General-purpose Nextflow pipeline for isoform switch analysis",
    "type": "object",
    "oneOf": [
        {
            "required": ["input", "outdir", "transcript_fasta", "genome_fasta", "gtf"]
        },
        {
            "required": ["sra_manifest", "outdir", "transcript_fasta", "genome_fasta", "gtf"]
        }
    ],
    "not": {
        "required": ["input", "sra_manifest"]
    },
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to FASTQ samplesheet.",
                    "help_text": "Primary input mode. Provide a CSV samplesheet with at least the columns `sample`, `condition`, `fastq_1`, and `strandedness`. Optional columns include `fastq_2` and `patient_id`. Repeated sample IDs are allowed for multiple sequencing runs of the same sample.",
                    "fa_icon": "fas fa-file-csv"
                },
                "sra_manifest": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_sra_manifest.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to SRA manifest.",
                    "help_text": "V1 public-data input mode. Provide a CSV manifest with at least the columns `sample`, `condition`, `sra_run`, and `strandedness`. The interface is defined now; the workflow branch still needs to be implemented.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory where the pipeline results will be saved.",
                    "fa_icon": "fas fa-folder-open"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion summary.",
                    "fa_icon": "fas fa-envelope",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$"
                },
                "multiqc_title": {
                    "type": "string",
                    "description": "Custom title shown at the top of the MultiQC report.",
                    "fa_icon": "fas fa-file-signature"
                }
            }
        },
        "reference_options": {
            "title": "Reference options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference files required by Salmon and IsoformSwitchAnalyzeR.",
            "properties": {
                "transcript_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.f(ast)?a(sta)?(\\.gz)?$",
                    "description": "Transcript FASTA used for Salmon quantification and downstream ISAR analysis.",
                    "fa_icon": "far fa-file-code"
                },
                "genome_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.f(ast)?a(sta)?(\\.gz)?$",
                    "description": "Genome FASTA used for decoy-aware Salmon indexing.",
                    "fa_icon": "far fa-file-code"
                },
                "gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.gtf(\\.gz)?$",
                    "description": "Transcript annotation GTF used by the ISAR step.",
                    "fa_icon": "far fa-file-alt"
                }
            }
        },
        "workflow_options": {
            "title": "Workflow options",
            "type": "object",
            "fa_icon": "fas fa-sliders-h",
            "description": "Controls for the major workflow stages.",
            "properties": {
                "skip_qc": {
                    "type": "boolean",
                    "description": "Skip FastQC.",
                    "default": false
                },
                "skip_trimming": {
                    "type": "boolean",
                    "description": "Skip fastp trimming and filtering.",
                    "default": false
                },
                "run_isar": {
                    "type": "boolean",
                    "description": "Run the IsoformSwitchAnalyzeR analysis step.",
                    "default": true
                }
            }
        },
        "salmon_options": {
            "title": "Salmon options",
            "type": "object",
            "fa_icon": "fas fa-fish",
            "description": "Parameters that control Salmon indexing and quantification.",
            "properties": {
                "salmon_index_k": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "k-mer size used when building the Salmon index."
                },
                "salmon_quant_libtype": {
                    "type": "string",
                    "default": "A",
                    "description": "Salmon library type to use, or `A` for auto-detection."
                },
                "extra_salmon_index_args": {
                    "type": ["string", "null"],
                    "description": "Additional arguments appended to the Salmon index command."
                },
                "extra_salmon_quant_args": {
                    "type": ["string", "null"],
                    "description": "Additional arguments appended to the Salmon quant command."
                }
            }
        },
        "isar_options": {
            "title": "ISAR options",
            "type": "object",
            "fa_icon": "fas fa-chart-line",
            "description": "Parameters controlling IsoformSwitchAnalyzeR comparison settings.",
            "properties": {
                "isar_condition_1": {
                    "type": ["string", "null"],
                    "description": "First condition label to compare, for example `normal`."
                },
                "isar_condition_2": {
                    "type": ["string", "null"],
                    "description": "Second condition label to compare, for example `tumor`."
                },
                "dif_cutoff": {
                    "type": "number",
                    "default": 0.1,
                    "description": "Minimum change in isoform usage required before a switch is considered meaningful."
                },
                "qvalue_cutoff": {
                    "type": "number",
                    "default": 0.05,
                    "description": "False-discovery-rate threshold used to decide statistical significance."
                },
                "isar_top_n": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "description": "How many top switch candidates to include in the main ranked output."
                },
                "isar_detect_unwanted_effects": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether ISAR should try to detect unwanted technical effects during import."
                }
            }
        },
        "sra_options": {
            "title": "SRA mode options",
            "type": "object",
            "fa_icon": "fas fa-download",
            "description": "Options for the V1 public-data input mode.",
            "properties": {
                "sra_prefetch_max_size": {
                    "type": "string",
                    "default": "500G",
                    "description": "Maximum archive size that prefetch is allowed to download."
                },
                "download_threads": {
                    "type": "integer",
                    "default": 4,
                    "minimum": 1,
                    "description": "Number of threads to use for download and FASTQ conversion steps."
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional config options",
            "type": "object",
            "fa_icon": "fas fa-university",
            "description": "Parameters used to describe centralised config profiles. These should not be edited.",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "description": "Git commit id for institutional configs.",
                    "default": "master",
                    "hidden": true
                },
                "custom_config_base": {
                    "type": "string",
                    "description": "Base directory for institutional configs.",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "Institutional config name.",
                    "hidden": true
                },
                "config_profile_description": {
                    "type": "string",
                    "description": "Institutional config description.",
                    "hidden": true
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "Institutional config contact information.",
                    "hidden": true
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "Institutional config URL link.",
                    "hidden": true
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for completion summary, only when pipeline fails.",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$",
                    "hidden": true
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send plain-text email instead of HTML.",
                    "hidden": true
                },
                "max_multiqc_email_size": {
                    "type": "string",
                    "description": "File size limit when attaching MultiQC reports to summary emails.",
                    "pattern": "^\\d+(\\.\\d+)?\\.?\\s*(K|M|G|T)?B$",
                    "default": "25.MB",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "hidden": true
                },
                "hook_url": {
                    "type": "string",
                    "description": "Incoming hook URL for messaging service.",
                    "hidden": true
                },
                "multiqc_config": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Custom config file to supply to MultiQC.",
                    "hidden": true
                },
                "multiqc_logo": {
                    "type": "string",
                    "description": "Custom logo file to supply to MultiQC.",
                    "hidden": true
                },
                "multiqc_methods_description": {
                    "type": "string",
                    "description": "Custom MultiQC YAML file containing a methods description."
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Validate parameters against the schema at runtime.",
                    "default": true,
                    "hidden": true
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "description": "Base URL or local path to location of pipeline test dataset files.",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "description": "Suffix to add to the trace report filename.",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full detailed help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/reference_options"
        },
        {
            "$ref": "#/$defs/workflow_options"
        },
        {
            "$ref": "#/$defs/salmon_options"
        },
        {
            "$ref": "#/$defs/isar_options"
        },
        {
            "$ref": "#/$defs/sra_options"
        },
        {
            "$ref": "#/$defs/institutional_config_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
