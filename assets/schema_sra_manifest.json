{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Anton-Bch/isoform-nf-core/main/assets/schema_sra_manifest.json",
    "title": "Anton-Bch/isoform-nf-core pipeline - params.sra_manifest schema",
    "description": "Schema for the file provided with params.sra_manifest",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "condition": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Condition must be provided and cannot be empty",
                "meta": ["condition"]
            },
            "sra_run": {
                "type": "string",
                "pattern": "^SRR[0-9]+$",
                "errorMessage": "SRA run must be provided and should look like SRR1234567",
                "meta": ["sra_run"]
            },
            "strandedness": {
                "type": "string",
                "errorMessage": "Strandedness must be one of 'auto', 'forward', 'reverse' or 'unstranded'",
                "enum": ["auto", "forward", "reverse", "unstranded"],
                "meta": ["strandedness"]
            },
            "patient_id": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["patient_id"]
            }
        },
        "required": ["sample", "condition", "sra_run", "strandedness"]
    }
}
