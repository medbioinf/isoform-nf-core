nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/isoform_software_mqc_versions.yml")).match() },
                { assert new File("$outputDir/fastqc/CONTROL_REP1_fastqc.html").exists() },
                { assert new File("$outputDir/cat/CONTROL_REP1.merged.fastq.gz").exists() },
                { assert new File("$outputDir/fastp/CONTROL_REP1.fastp.json").exists() },
                { assert new File("$outputDir/salmon/salmon/versionInfo.json").exists() },
                { assert new File("$outputDir/salmon/CONTROL_REP1/quant.sf").exists() },
                { assert new File("$outputDir/salmon/CONTROL_REP1_lib_format_counts.json").text.contains('"expected_format": "U"') },
                { assert new File("$outputDir/salmon/CONTROL_REP1_requested_lib_type.txt").text.trim() == 'A' },
                { assert new File("$outputDir/isar/isar_analysis/switch_summary.csv").exists() },
                { assert new File("$outputDir/isar/isar_analysis/design_matrix.csv").readLines().first().contains('batch') },
                { assert new File("$outputDir/isar/isar_analysis/go_gene_scores.csv").text.contains('GENE1') },
                { assert new File("$outputDir/isar/isar_contrast_summary/significant_isoform_switches_per_comparison.csv").exists() },
                { assert new File("$outputDir/isar/isar_visualization/comparison_visualizations.csv").exists() },
                { assert new File("$outputDir/isar/isar_visualization/treated_vs_control/top_isoform_candidates.csv").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert new File("$outputDir/pipeline_info/isoform_software_mqc_versions.yml").exists() }
            )
        }
    }

    test("-profile test paired-end with Salmon auto inference") {

        when {
            params {
                input = "${projectDir}/tests/fixtures/samplesheet_paired.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/fastp/CONTROL_REP1_R1.fastp.fastq.gz").exists() },
                { assert new File("$outputDir/fastp/CONTROL_REP1_R2.fastp.fastq.gz").exists() },
                { assert new File("$outputDir/salmon/CONTROL_REP1_lib_format_counts.json").text.contains('"expected_format": "IU"') },
                { assert new File("$outputDir/salmon/CONTROL_REP1_requested_lib_type.txt").text.trim() == 'A' },
                { assert new File("$outputDir/isar/isar_analysis/design_matrix.csv").readLines().first().contains('batch') },
                { assert new File("$outputDir/isar/isar_analysis/go_gene_scores.csv").text.contains('GENE1') },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("-profile test GO enrichment wiring - stub") {

        options "-stub"

        when {
            params {
                run_go_enrichment = true
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/go/go_input/significant_genes.txt").exists() },
                { assert new File("$outputDir/go/go_input/background_genes.txt").exists() },
                { assert new File("$outputDir/go/go_input/go_gene_scores.csv").exists() },
                { assert new File("$outputDir/go/go_enrichment.csv").exists() },
                { assert new File("$outputDir/go/go_summary.txt").exists() }
            )
        }
    }
}
